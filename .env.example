# Choose one AI provider. Gemini is used first when both keys are present.
GEMINI_API_KEY=
# GEMINI_MODEL=gemini-3.5-flash

# Groq keys start with gsk_.
# GROQ_API_KEY=
# GROQ_MODEL=llama-3.3-70b-versatile

# Optional xAI/Grok provider (keys start with xai-).
# XAI_API_KEY=
# GROK_MODEL=grok-3-latest

# Required by the rates and quote features (not the chatbot).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
